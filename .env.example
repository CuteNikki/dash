# The server this dashboard is for: the name its heading and tab show,
# built in as the browser shows it too, and the name ssh knows it by, which
# `bun run tunnels` and `bun run deploy` connect to
NEXT_PUBLIC_SERVER_NAME=vps.example.com
DASH_SSH_HOST=vps.example.com
# The dashboard's clone on the server, which `bun run deploy` pulls into
DASH_SERVER_DIR=~/services/dash
# The folder the stacks live in, on the server and at the same path in the dashboard
STACKS_ROOT=/home/you

# The Docker socket, or in development a tunnel to the server's, which
# `bun run tunnels` opens
DOCKER_HOST=tcp://127.0.0.1:2375

# Signs sessions. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Where the dashboard runs. Passkeys only work on this address.
BETTER_AUTH_URL=http://localhost:3000

# The dashboard's database, named dash, on the server's PostgreSQL (DASH_REMOTE_URL in ~/services/postgres/credentials.env)
DATABASE_URL=postgresql://dash:PASSWORD@vps.example.com:5432/dash?sslmode=verify-full

# Uploaded icons go to the dashboard's own bucket in S3 storage (Garage), under icons/:
# its S3 API, where the bucket's files are read from, and the bucket
STORAGE_API_URL=https://s3.example.com
STORAGE_PUBLIC_URL=https://images.example.com/dash
STORAGE_BUCKET=dash
# A key of its own: docker exec garage /garage key info dash-site --show-secret
# Garage's Browse tab uses it too, letting it into each bucket the first time that bucket is opened
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Live numbers on the apps' tiles. Each is read only once its keys are set,
# from its container by name (http://sonarr:8989 and so on), or from
# SONARR_URL and the like where that isn't it. Sonarr, Radarr and Prowlarr's
# keys are in Settings → General; Jellyfin's in Dashboard → API Keys.
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
JELLYFIN_API_KEY=
# Jellyseerr's, in its Settings → General
SEERR_API_KEY=
# Stalwart's: an API key made under Account › Credentials › API Keys, with
# only "Sign in to the server" and the two for querying and getting queued
# messages, and allowed from 172.16.0.0/12, the server's containers
STALWART_API_KEY=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
# qBittorrent shares the VPN container's network, so it's reached by its name
QBITTORRENT_URL=http://gluetun:8080
# In development, where the apps' names don't reach them: `bun run tunnels`,
# and each at the port it opens, e.g. SONARR_URL=http://127.0.0.1:18989
# (Radarr 17878, Prowlarr 19696, Jellyfin 18096, Jellyseerr 15055 as SEERR_URL,
# FlareSolverr 18191, Stalwart 18088, Ludo 13001 as LUDO_SERVER_URL,
# qBittorrent 8080, its own, since it turns away an address with another port)

# In development only: a container on the server sharing its process
# namespace, to read the server's CPU, memory, disk and network through:
#   docker run -d --name dash-dev-stats --pid host --restart unless-stopped alpine:3.22 sleep infinity
# Left out where the dashboard itself runs on the server, with pid: host.
HOST_HELPER_CONTAINER=

# Mail, for invites, forgotten passwords, confirming addresses and alerts:
# an account of its own on the mail server (Stalwart's submission port, 465
# with TLS), and the address it's from. Without SMTP_HOST and MAIL_FROM the
# dashboard sends nothing, and says so where it would.
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Dashboard <dash@example.com>

# Keeps the record of the server and the websites, a reading a minute, for
# History, uptime and alerts. On by itself where the dashboard runs on the
# server; off in development, which shares its database, unless set to on.
# MONITOR=on
