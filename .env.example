# The Docker socket, or in development a tunnel to the server's:
#   ssh -N -L 127.0.0.1:2375:/var/run/docker.sock vps.niso.moe
DOCKER_HOST=tcp://127.0.0.1:2375

# Signs sessions. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Where the dashboard runs. Passkeys only work on this address.
BETTER_AUTH_URL=http://localhost:3000

# The dash database on the server's PostgreSQL (DASH_REMOTE_URL in ~/services/postgres/credentials.env)
DATABASE_URL=postgresql://dash:PASSWORD@vps.niso.moe:5432/dash?sslmode=verify-full
