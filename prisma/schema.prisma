generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// How a container's tile looks. Empty fields fall back to the container's
/// Homepage labels, then to its name.
model Tile {
  /// "<compose project>/<service>", or the container name outside compose
  key         String   @id
  name        String?
  /// A short line under its name
  description String?
  /// A dashboard-icons name, "mdi-…", "si-…" or an https:// address
  icon        String?
  /// Where to reach it, one per line on the tile: links (https://…), or
  /// plain text such as a host and port for a game server
  addresses   String[] @default([])
  group       String?
  /// Order within its group, lowest first
  position    Int?
  /// Columns and rows it spans in its group's grid
  width       Int      @default(1)
  height      Int      @default(1)
  hidden      Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

/// Where one of the server's tiles goes, and its size, once it's been moved
/// or resized; until then it has its place and size in lib/host/host-tiles.ts.
model HostTile {
  /// "server", "cpu", "processes", …
  key      String @id
  position Int
  width    Int
  height   Int
}

/// Where a tile sits once it's been arranged at a number of columns: its
/// first column and row, from 0, and the columns and rows it spans. Each
/// number of columns has its own; one not arranged comes from the nearest.
model TileLayout {
  /// A service's tile key, or "host:cpu" and so on for the server's
  key     String
  columns Int
  x       Int
  y       Int
  w       Int
  h       Int

  @@id([key, columns])
}

/// The order groups are shown in. Groups exist as long as a tile is in them.
model Group {
  name     String @id
  position Int
}

// Better Auth's tables. The first account, made on /setup, is the owner;
// others are made from the owner's invites.

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  // What they may do: owner, admin, operator or viewer (lib/auth/access.ts)
  role             String?
  // Disabled by the owner: no session is given while it's set
  banned           Boolean?    @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?    @default(false)
  // The groups an operator or viewer sees; an owner or admin sees all
  allowedGroups    String[]    @default([])
  // Mailed the monitor's alerts, for those who see the server
  alertMail        Boolean     @default(true)
  sessions         Session[]
  accounts         Account[]
  passkeys         Passkey[]
  twoFactors       TwoFactor[]
  invites          Invite[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Better Auth's admin plugin's, though impersonating is turned off
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// An authenticator app's secret and the backup codes, once two-factor is on
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
  @@map("twoFactor")
}

// dash's own: a link the owner sends someone to make their account with,
// for a day, once. Only the token's hash is kept, so the link can't be read
// back out of the database.
model Invite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  email       String
  role        String
  groups      String[]  @default([])
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  /// Sent by mail, so whoever has the link has the address too
  emailed     Boolean   @default(false)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}

// What the server and its services did, kept for a while by the monitor
// (lib/monitor), which takes a reading a minute whether or not anyone's
// watching, so "what happened last night" has an answer.

/// The server over one minute: averages over it, and what was in use at its end.
model HostSample {
  at          DateTime @id
  /// Percent of all cores together
  cpu         Float
  /// Bytes
  memory      Float
  diskUsed    Float
  /// Bytes per second
  received    Float
  sent        Float
  diskRead    Float
  diskWritten Float
  /// Milliseconds the disk took per read or write, on average; a stall shows here
  diskWait    Float
  /// Processes waiting for the CPU, over the last minute
  load        Float
  /// Percent of all cores' time the provider gave to other machines on the
  /// same host instead; while it's high, everything here runs slower
  /// Null in readings from before it was kept
  steal       Float?
}

/// One service's container over one minute.
model ContainerSample {
  /// The service's tile key, which outlives its container being recreated
  key    String
  at     DateTime
  /// Percent of one core
  cpu    Float
  /// Bytes
  memory Float

  @@id([key, at])
  // For clearing out the old ones, every service's at once
  @@index([at])
}

/// One look at a website tile's page: whether it answered, and how fast.
model SiteCheckLog {
  /// The site's tile key, "site:…"
  key    String
  at     DateTime
  ok     Boolean
  ms     Float
  /// The HTTP status it answered with, if it answered
  status Int?
  /// Why it didn't answer, if it didn't
  error  String?

  @@id([key, at])
  @@index([at])
}

/// Something done from the dashboard, by whom and when: starting and stopping,
/// updates, files, people's accounts… Kept for 90 days.
model Activity {
  id     String   @id @default(cuid())
  at     DateTime @default(now())
  /// Who, by id while their account's there, and by name as it was then
  userId String?
  user   String
  /// What they did: "stop", "update", "file.save"… (lib/activity)
  action String
  /// What to: a service, a file, someone's account
  target String?
  /// More about it: a command typed, a commit's message, a role
  detail String?
  /// Whether it worked; one that didn't says why in error
  ok     Boolean  @default(true)
  error  String?

  @@index([at])
}

/// Something wrong the monitor noticed, from when it began until it was
/// right again: a service down, the disk filling, a website not answering,
/// a certificate running out, a backup failing. Kept 90 days once it's over.
model Alert {
  id         String    @id @default(cuid())
  /// What it's about, the same each time: "service:papermc/minecraft-paper",
  /// "disk", "site:…", "cert:example.com", "backup:postgres"
  key        String
  /// service, disk, site, cert or backup
  kind       String
  /// What's wrong, in a few words, as it was last found: "Stopped, exit code 137"
  message    String
  /// What it's about, for reading: "minecraft", "niso.moe"
  subject    String
  since      DateTime  @default(now())
  /// Mailed to those who get alerts; none until it's lasted long enough
  notifiedAt DateTime?
  /// Over, as it was right again; none while it's open
  resolvedAt DateTime?

  @@index([key, resolvedAt])
  @@index([since])
}

/// One run of the backups, every part of it, nightly or asked for: how
/// each part went. The backups themselves are restic's snapshots.
model BackupRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// "schedule", or the name of who asked for it
  trigger    String
  /// Each part's outcome: [{ source, ok, error?, added? }]
  results    Json      @default("[]")

  @@index([startedAt])
}

/// A part of the backups as it's been set here: one switched off, as a
/// game server nobody plays on, or a folder added outside ~/services, as
/// apps' settings kept elsewhere. Every other part is backed up as found.
model BackupSource {
  /// "postgres/dash", "folder/papermc", "path:/docker/config"
  id      String  @id
  enabled Boolean @default(true)
  /// For a folder added here: where it is on the server
  path    String?
}
