generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// How a container's tile looks. Empty fields fall back to the container's
/// Homepage labels, then to its name.
model Tile {
  /// "<compose project>/<service>", or the container name outside compose
  key         String   @id
  name        String?
  /// A short line under its name
  description String?
  /// A dashboard-icons name, "mdi-…", "si-…" or an https:// address
  icon        String?
  /// Where to reach it, one per line on the tile: links (https://…), or
  /// plain text such as a host and port for a game server
  addresses   String[] @default([])
  group       String?
  /// Order within its group, lowest first
  position    Int?
  /// Columns and rows it spans in its group's grid
  width       Int      @default(1)
  height      Int      @default(1)
  hidden      Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

/// Where one of the server's tiles goes, and its size, once it's been moved
/// or resized; until then it has its place and size in lib/host/host-tiles.ts.
model HostTile {
  /// "server", "cpu", "processes", …
  key      String @id
  position Int
  width    Int
  height   Int
}

/// Where a tile sits once it's been arranged at a number of columns: its
/// first column and row, from 0, and the columns and rows it spans. Each
/// number of columns has its own; one not arranged comes from the nearest.
model TileLayout {
  /// A service's tile key, or "host:cpu" and so on for the server's
  key     String
  columns Int
  x       Int
  y       Int
  w       Int
  h       Int

  @@id([key, columns])
}

/// The order groups are shown in. Groups exist as long as a tile is in them.
model Group {
  name     String @id
  position Int
}

// Better Auth's tables. The first account, made on /setup, is the owner;
// others are made from the owner's invites.

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  // What they may do: owner, admin, operator or viewer (lib/auth/access.ts)
  role             String?
  // Disabled by the owner: no session is given while it's set
  banned           Boolean?    @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?    @default(false)
  // The groups an operator or viewer sees; an owner or admin sees all
  allowedGroups    String[]    @default([])
  sessions         Session[]
  accounts         Account[]
  passkeys         Passkey[]
  twoFactors       TwoFactor[]
  invites          Invite[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // Better Auth's admin plugin's, though impersonating is turned off
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// An authenticator app's secret and the backup codes, once two-factor is on
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([userId])
  @@index([secret])
  @@map("twoFactor")
}

// dash's own: a link the owner sends someone to make their account with,
// for a day, once. Only the token's hash is kept, so the link can't be read
// back out of the database.
model Invite {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  email       String
  role        String
  groups      String[]  @default([])
  invitedById String
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
}
