generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// How a container's tile looks. Empty fields fall back to the container's
/// Homepage labels, then to its name.
model Tile {
  /// "<compose project>/<service>", or the container name outside compose
  key         String   @id
  name        String?
  /// A short line under its name
  description String?
  /// A dashboard-icons name, "mdi-…", "si-…" or an https:// address
  icon        String?
  /// Where to reach it, one per line on the tile: links (https://…), or
  /// plain text such as a host and port for a game server
  addresses   String[] @default([])
  group       String?
  /// Order within its group, lowest first
  position    Int?
  /// Columns and rows it spans in its group's grid
  width       Int      @default(1)
  height      Int      @default(1)
  hidden      Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

/// Where one of the server's tiles goes, and its size, once it's been moved
/// or resized; until then it has its place and size in lib/host/host-tiles.ts.
model HostTile {
  /// "server", "cpu", "processes", …
  key      String @id
  position Int
  width    Int
  height   Int
}

/// Where a tile sits once it's been arranged at a number of columns: its
/// first column and row, from 0, and the columns and rows it spans. Each
/// number of columns has its own; one not arranged comes from the nearest.
model TileLayout {
  /// A service's tile key, or "host:cpu" and so on for the server's
  key     String
  columns Int
  x       Int
  y       Int
  w       Int
  h       Int

  @@id([key, columns])
}

/// The order groups are shown in. Groups exist as long as a tile is in them.
model Group {
  name     String @id
  position Int
}

// Better Auth's tables. There's one account: the first one, made on /setup.

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
